        faceTrackingParameterBehaviors:
        - targetMode: 2
          outputParameterName: NewParameter1
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Open
          weightBlendSetName: LimitsDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawOpen * (1 - MouthClosed)
        - targetMode: 2
          outputParameterName: NewParameter1
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Open
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawOpen * (1 - MouthClosed) + TongueOut / 4 * (1 - JawOpen)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Ape_Shape
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthClosed * JawOpen
        - targetMode: 2
          outputParameterName: NewParameter3
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Right
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawRight * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: NewParameter2
          targetBlendSetName: 
          targetBlendshapeName: Jaw_Left
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawLeft * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: NewParameter23
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Smile_Right
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullRight * 0.8 + MouthCornerSlantRight *
            0.2
        - targetMode: 2
          outputParameterName: NewParameter22
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Smile_Left
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullLeft * 0.8 + MouthCornerSlantLeft * 0.2
        - targetMode: 2
          outputParameterName: NewParameter8
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Sad_Right
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthFrownRight * (1 - (MouthUpperRight + MouthLowerRight)
            / 6)
        - targetMode: 2
          outputParameterName: NewParameter7
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Sad_Left
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthFrownLeft * (1 - (MouthUpperLeft + MouthLowerLeft)
            / 6)
        - targetMode: 2
          outputParameterName: NewParameter32
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Pout
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipPuckerUpperRight + LipPuckerUpperLeft + LipPuckerLowerRight
            + LipPuckerLowerLeft) / 4) * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter33
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Upper_Inside
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipSuckUpperRight + LipSuckUpperLeft) / 2) * (1 - MouthClosed
            / 3)
        - targetMode: 2
          outputParameterName: NewParameter34
          targetBlendSetName: 
          targetBlendshapeName: Mouth_Lower_Inside
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipSuckLowerRight + LipSuckLowerLeft) / 2) * (1 - MouthClosed
            / 3)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_LongStep1
          weightBlendSetName: LimitsDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: clamp( TongueOut, 0 , 0.5) * 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_LongStep2
          weightBlendSetName: LimitsDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ( clamp( TongueOut, 0.5 , 1) - 0.5 ) * 2
        - targetMode: 2
          outputParameterName: NewParameter14
          targetBlendSetName: 
          targetBlendshapeName: Tongue_LongStep1
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: clamp( TongueOut, 0 , 0.5) * 2 * (1 - (LipFunnelUpperLeft
            + LipFunnelUpperRight + LipFunnelLowerLeft + LipFunnelLowerRight) / 2.8)
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_LongStep2
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ( clamp( TongueOut, 0.5 , 1) - 0.5 ) * 2 * (1 - (LipFunnelUpperLeft
            + LipFunnelUpperRight + LipFunnelLowerLeft + LipFunnelLowerRight) / 2.8)
        - targetMode: 0
          outputParameterName: FT/EyeLidRight
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedRight
          weightBlendSetName: EyeClosedCompensation
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: 0.75 - 0.75 * EyeClosedRight + 0.25 * EyeWideRight
        - targetMode: 0
          outputParameterName: FT/EyeLidLeft
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedLeft
          weightBlendSetName: EyeClosedCompensation
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: 0.75 - 0.75 * EyeClosedLeft + 0.25 * EyeWideLeft
        - targetMode: 0
          outputParameterName: FT/EyeSquintRight
          targetBlendSetName: 
          targetBlendshapeName: 
          weightBlendSetName: 
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeSquintRight
        - targetMode: 0
          outputParameterName: FT/EyeSquintLeft
          targetBlendSetName: 
          targetBlendshapeName: 
          weightBlendSetName: 
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeSquintLeft
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Right_Dilation
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthFrownLeft + MouthFrownRight) / 2 - (EyeWideLeft
            + EyeWideRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Left_Dilation
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthFrownLeft + MouthFrownRight) / 2 - (EyeWideLeft
            + EyeWideRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Right_Constrict
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ' (EyeWideLeft + EyeWideRight) / 2 - (MouthFrownLeft
            + MouthFrownRight) / 2'
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Eye_Left_Constrict
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ' (EyeWideLeft + EyeWideRight) / 2 - (MouthFrownLeft
            + MouthFrownRight) / 2'
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: Tongue_UpLeft_Morph
          targetBlendshapeName: Tongue_UpLeft_Morph
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueUp + TongueLeft) / 2
        - targetMode: 2
          outputParameterName: Tongue_UpRight_Morph
          targetBlendSetName: 
          targetBlendshapeName: Tongue_UpRight_Moprh
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueUp + TongueRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_DownLeft_Morph
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (TongueDown + TongueLeft) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: Tongue_DownRight_Morph
          weightBlendSetName: SRanipal
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
