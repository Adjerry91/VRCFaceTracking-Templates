        faceTrackingParameterBehaviors:
        - targetMode: 2
          outputParameterName: NewParameter14
          targetBlendSetName: 
          targetBlendshapeName: TongueOut
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: TongueOut * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 2.8)
        - targetMode: 2
          outputParameterName: NewParameter27
          targetBlendSetName: 
          targetBlendshapeName: BrowInnerUp
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthFrownLeft + MouthFrownRight) / 2 - MouthClosed
            / 2 + (BrowInnerUpLeft + BrowInnerUpRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowInnerUpCorrective
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (BrowInnerUpLeft + BrowInnerUpRight) / 2 * (EyeClosedLeft
            + EyeClosedRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowInnerUpCorrective
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((MouthFrownLeft + MouthFrownRight) / 2 - MouthClosed
            / 2 + (BrowInnerUpLeft + BrowInnerUpRight) / 2) * (EyeClosedLeft + EyeClosedRight)
            / 2
        - targetMode: 2
          outputParameterName: NewParameter19
          targetBlendSetName: 
          targetBlendshapeName: BrowDownRight
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowLowererRight * 0.75 + BrowPinchRight * 0.25
        - targetMode: 2
          outputParameterName: NewParameter18
          targetBlendSetName: 
          targetBlendshapeName: BrowDownLeft
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowLowererLeft * 0.75 + BrowPinchLeft * 0.25
        - targetMode: 2
          outputParameterName: NewParameter29
          targetBlendSetName: 
          targetBlendshapeName: BrowDownRight
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthRaiserLower + (NoseSneerLeft + NoseSneerRight) /
            2 + BrowLowererRight * 0.75 + BrowPinchRight * 0.25
        - targetMode: 2
          outputParameterName: NewParameter28
          targetBlendSetName: 
          targetBlendshapeName: BrowDownLeft
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthRaiserLower + (NoseSneerLeft + NoseSneerRight) /
            2 + BrowLowererLeft * 0.75 + BrowPinchLeft * 0.25
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowDownCorrectiveRight
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowLowererRight * 0.75 + BrowPinchRight * 0.25 * EyeClosedRight
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowDownCorrectiveLeft
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowLowererLeft * 0.75 + BrowPinchLeft * 0.25 * EyeClosedLeft
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowDownCorrectiveRight
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthRaiserLower + (NoseSneerLeft + NoseSneerRight)
            / 2 + BrowLowererRight * 0.75 + BrowPinchRight * 0.25) * (EyeClosedLeft
            + EyeClosedRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowDownCorrectiveLeft
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (MouthRaiserLower + (NoseSneerLeft + NoseSneerRight)
            / 2  + BrowLowererLeft * 0.75 + BrowPinchLeft * 0.25) * (EyeClosedLeft
            + EyeClosedRight) / 2
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowOuterUpCorrectiveRight
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowOuterUpRight * EyeClosedRight
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowOuterUpCorrectiveLeft
          weightBlendSetName: EmulationDisabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: BrowOuterUpLeft * EyeClosedLeft
        - targetMode: 2
          outputParameterName: NewParameter27
          targetBlendSetName: 
          targetBlendshapeName: BrowOuterUpRight
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: EyeWideRight / 3 + BrowOuterUpRight
        - targetMode: 2
          outputParameterName: NewParameter28
          targetBlendSetName: 
          targetBlendshapeName: BrowOuterUpLeft
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: 'EyeWideLeft / 3 + BrowOuterUpLeft '
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowOuterUpCorrectiveRight
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (EyeWideRight / 3 + BrowOuterUpRight) * EyeClosedRight
        - targetMode: 2
          outputParameterName: 
          targetBlendSetName: 
          targetBlendshapeName: EyeClosedBrowOuterUpCorrectiveLeft
          weightBlendSetName: EmulationEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: (EyeWideLeft  / 3 + BrowOuterUpLeft)  * EyeClosedLeft
        - targetMode: 2
          outputParameterName: NewParameter1
          targetBlendSetName: 
          targetBlendshapeName: JawOpen
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawOpen + TongueOut / 4 * (1 - JawOpen)
        - targetMode: 2
          outputParameterName: NewParameter3
          targetBlendSetName: 
          targetBlendshapeName: JawRight
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawRight * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: NewParameter2
          targetBlendSetName: 
          targetBlendshapeName: JawLeft
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: JawLeft * (1 - abs((MouthUpperRight + MouthLowerRight
            - MouthUpperLeft - MouthLowerLeft) / 4))
        - targetMode: 2
          outputParameterName: NewParameter5
          targetBlendSetName: 
          targetBlendshapeName: MouthUpperUpRight
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthUpperUpRight * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter4
          targetBlendSetName: 
          targetBlendshapeName: MouthUpperUpLeft
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthUpperUpLeft * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter35
          targetBlendSetName: 
          targetBlendshapeName: MouthLowerDownRight
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthLowerDownRight * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter6
          targetBlendSetName: 
          targetBlendshapeName: MouthLowerDownLeft
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthLowerDownLeft * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter23
          targetBlendSetName: 
          targetBlendshapeName: MouthSmileRight
          weightBlendSetName: Unified Expressions
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullRight * 0.8 + MouthCornerSlantRight *
            0.2
        - targetMode: 2
          outputParameterName: NewParameter22
          targetBlendSetName: 
          targetBlendshapeName: MouthSmileLeft
          weightBlendSetName: Unified Expressions
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthCornerPullLeft * 0.8 + MouthCornerSlantLeft * 0.2
        - targetMode: 2
          outputParameterName: NewParameter8
          targetBlendSetName: 
          targetBlendshapeName: MouthFrownRight
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthFrownRight * (1 - (MouthUpperRight + MouthLowerRight)
            / 6)
        - targetMode: 2
          outputParameterName: NewParameter7
          targetBlendSetName: 
          targetBlendshapeName: MouthFrownLeft
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: MouthFrownLeft * (1 - (MouthUpperLeft + MouthLowerLeft)
            / 6)
        - targetMode: 2
          outputParameterName: NewParameter32
          targetBlendSetName: 
          targetBlendshapeName: LipPucker
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipPuckerUpperRight + LipPuckerUpperLeft + LipPuckerLowerRight
            + LipPuckerLowerLeft) / 4) * (1 - (LipFunnelUpperLeft + LipFunnelUpperRight
            + LipFunnelLowerLeft + LipFunnelLowerRight) / 4)
        - targetMode: 2
          outputParameterName: NewParameter33
          targetBlendSetName: 
          targetBlendshapeName: LipSuckUpper
          weightBlendSetName: LimitsEnabled
          inputTrackingKeys: 
          inputTrackingKeyNames: []
          inputInverted: 
          combineMode: 4
          customExpression: ((LipSuckUpperRight + LipSuckUpperLeft) / 2 ) * (1 -
            MouthClosed / 3)
        - targetMode: 2
